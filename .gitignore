# Default-deny repository root. Only the canonical project tree is allowed.
*
!*/
!/.gitignore
!/README.md
!/AGENTS.md
!/AGENT.md
!/metadata.json
!/.githooks/
!/.githooks/**
!/.github/
!/.github/**
!/docs/
!/docs/**
!/skills/
!/skills/**
!/surface/
!/surface/**
!/mac/
!/mac/**

# Python caches and tooling output
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage.xml
htmlcov/
test-results/
artifacts/

# Local environments, runtime state, logs, and personal files
.env/
surface/.env/
logs/
*.log
*.tmp
*.bak
*.backup
*.bak.*
*.backup.*
.DS_Store
mac/local.env
mac/schedule.json
mac/*.log

# Local photo/runtime compatibility paths
photo/
photos/
public_photos/
.review_delete/
chatgpt-ui-once/
